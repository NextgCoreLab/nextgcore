# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are read by the scripts that source this
# PROFILE=6g -- sourced by build-and-push.sh, deploy-eks.sh and e2e-internet.sh.
#
# The 5G profile (same NFs, same rollout order, same gNB/UE) in namespace
# nextg-6g, with the core built with the runtime 6G / research cargo features
# and those features switched on in config. Validated by
# deploy/eks/e2e-internet.sh PROFILE=6g, which adds a 6G feature smoke to the
# 5G UE-to-internet checks.

# Start from the 5G profile: its NF list, rollout waits, advertise set, hnet
# Secret and data-plane swap are what this profile runs too.
# shellcheck source=../5g/profile.env
source "$(dirname "${BASH_SOURCE[0]}")/../5g/profile.env"

PROFILE_NAMESPACE="nextg-6g"
PROFILE_NAMESPACE_MANIFEST="deploy/eks/profiles/6g/namespace.yaml"
# The UE-to-internet check needs the data-plane UPF (TUN + NAT).
PROFILE_POD_SECURITY="privileged"

# The runtime 6G / research features of the NFs this profile runs (each also
# in ci.yml's research-features job). The others in that job are not here:
# nwdafd and nsacfd are not deployed, and nextgcore-sbi/app's 6g-extensions,
# http3 and pqc-tls gate library modules no deployed NF calls.
#   amfd ntn                 NTN timer extension for satellite-access UEs
#   smfd compute-aware-upf   least-loaded UPF selection from the PFCP load report
#   upfd compute-aware-upf   Load Control Information on every PFCP heartbeat
#   pcfd intent-loop         intent-driven closed-loop policy controller
#   udmd nes                 network energy saving state machine + energy gauges
# The gNB and UE are the default nextgsim build: their 6G crates are
# in-process research modules with no wire behaviour toward this core.
PROFILE_CARGO_FEATURES="nextgcore-amfd/ntn nextgcore-smfd/compute-aware-upf nextgcore-upfd/compute-aware-upf nextgcore-pcfd/intent-loop nextgcore-udmd/nes"
PROFILE_TAG_SUFFIX="-6g"

# A feature build never goes to nextgcore/binaries/, which holds the default
# build the 5g profile packages: the -6g tag would otherwise label default
# binaries as a feature build. CORE_BIN_DIR still overrides.
CORE_BIN_DIR="${CORE_BIN_DIR:-/tmp/6g-binaries}"

# UDM energy gauges port, inside the pod only (loopback unless
# NEXTGCORE_METRICS_BIND says otherwise, #837). Not 9090: the NFs' own
# metrics listener.
NES_METRICS_PORT="${NES_METRICS_PORT:-9091}"

profile_build_hint() {
  local b pkgs="" core="" sim="" f
  for b in ${MISSING_CORE_BINS[@]+"${MISSING_CORE_BINS[@]}"}; do
    pkgs+=" -p ${b}"
    core+=" \"\${CARGO_TARGET_DIR}\"/release/${b}"
  done
  for b in ${MISSING_SIM_BINS[@]+"${MISSING_SIM_BINS[@]}"}; do
    sim+=" target/release/${b}"
  done
  if [[ -n "${core}" ]]; then
    # One cargo invocation, -p per crate, so each feature lands only on the
    # crate that names it.
    printf '  cd %s/src && export CARGO_TARGET_DIR=/tmp/tgt-rel-6g && \\\n' "${CORE_DIR}"
    printf '    cargo build --release%s' "${pkgs}"
    # Only the features of the crates being built: cargo refuses a
    # `--features <crate>/<f>` whose crate is not selected with -p (#1333 review).
    for f in ${PROFILE_CARGO_FEATURES}; do
      [[ " ${pkgs} " == *" -p ${f%%/*} "* ]] && printf ' --features %s' "${f}"
    done
    printf ' && \\\n    mkdir -p %s && cp%s %s/\n' "${CORE_BIN_DIR}" "${core}" "${CORE_BIN_DIR}"
  fi
  if [[ -n "${sim}" ]]; then
    printf '  cd %s && cargo build --release && \\\n' "${SIM_DIR}"
    printf '    mkdir -p binaries && cp%s binaries/\n' "${sim}"
  fi
}

# Retarget the 5G render at this namespace and switch the features on.
profile_postrender() {
  python3 - "$1" "${NAMESPACE}" "${NES_METRICS_PORT}" <<'PY'
import sys, yaml
path, ns, nes_port = sys.argv[1], sys.argv[2], int(sys.argv[3])
src = open(path).read()
# Service FQDNs in the NF configs, the mongodb-init Job and the Grafana
# datasources name nextg-system; here that would register with, or seed, the
# 5G profile's core.
src = src.replace('.nextg-system.svc.cluster.local', f'.{ns}.svc.cluster.local')
out, done = [], set()
for d in yaml.safe_load_all(src):
    if not d:
        continue
    if d.get('kind') == 'ConfigMap' and d['metadata']['name'] == 'nextgcore-configs':
        data = d['data']
        udm = yaml.safe_load(data['udm.yaml'])
        # NES on, with an idle threshold no lab run reaches: a SUSPENDED UDM
        # would fail every registration. The smoke checks the state machine
        # and the gauges, not a sleep.
        udm['udm']['nes'] = {
            'enabled': True,
            'idle_threshold_secs': 86400,
            'poll_interval_secs': 5,
            'action': 'suspend',
            'metrics_port': nes_port,
        }
        data['udm.yaml'] = yaml.safe_dump(udm, default_flow_style=False, sort_keys=False)
        pcf = yaml.safe_load(data['pcf.yaml'])
        # No NWDAF is deployed, so the loop observes "unavailable" and holds
        # the baseline policy; it still translates the intent and monitors.
        pcf['pcf']['intent'] = {
            'enabled': True,
            'sst': 1,
            'max_latency_ms': 20.0,
            'poll_interval_secs': 10,
            'aggressiveness': 0.5,
        }
        data['pcf.yaml'] = yaml.safe_dump(pcf, default_flow_style=False, sort_keys=False)
        done.add('configs')
    out.append(d)
if 'configs' not in done:
    sys.exit('6g: ConfigMap nextgcore-configs not found')
rendered = yaml.safe_dump_all(out, default_flow_style=False)
if 'nextg-system' in rendered:
    sys.exit('6g: a nextg-system reference survived in the render')
open(path, 'w').write(rendered)
PY
}

profile_summary() {
  cat <<EOS

Deployed (PROFILE=6g, features: ${PROFILE_CARGO_FEATURES}).

Verify:
  kubectl logs -n ${NAMESPACE} deploy/udm | grep 'NES enabled'
  kubectl logs -n ${NAMESPACE} deploy/pcf | grep 'intent-loop: monitor'
  PROFILE=6g ./e2e-internet.sh
EOS
  if [[ "${ENABLE_DATAPLANE}" != "true" ]]; then
    cat <<EOS

NOTE: the UPF is running with --no-dataplane, so a UE ping will NOT work.
Re-run with ENABLE_DATAPLANE=true for the UE-to-internet check.
EOS
  fi
}
