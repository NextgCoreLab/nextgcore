# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are read by the scripts that source this
# PROFILE=epc -- sourced by build-and-push.sh and deploy-eks.sh.
#
# The standalone EPC of docker/rust/docker-compose-epc.yml plus nextgsim's LTE
# eNB and UE, validated by deploy/eks/e2e-internet.sh PROFILE=epc.

PROFILE_NAMESPACE="nextg-epc"
PROFILE_NAMESPACE_MANIFEST="deploy/eks/profiles/epc/namespace.yaml"
# SGW-U, PGW-U and the LTE UE need TUN devices; the PGW-U NATs to the internet.
PROFILE_POD_SECURITY="privileged"
# The NF configs are rendered from their real paths in docker/rust/configs/epc
# and nextgsim/config, outside this directory.
PROFILE_KUSTOMIZE_FLAGS="--load-restrictor LoadRestrictionsNone"

# S1-MME is kernel SCTP, as in the nightly EPC stage (Dockerfile.builder):
# mmed and lte-enb are built with their kernel-sctp features, so the node
# needs the `sctp` kernel module. The other NFs are the default build.
PROFILE_CARGO_FEATURES="nextgcore-mmed/kernel-sctp nextgsim-enb/kernel-sctp"
PROFILE_TAG_SUFFIX=""

# One image per binary: smf and upf are the PGW-C and PGW-U (#380) and are the
# same images the 5g profile pushes, so an existing tag is not re-pushed.
# mmed must be the kernel-sctp build: point CORE_BIN_DIR at a directory
# holding it next to the six default-build binaries.
PROFILE_CORE_NFS=(
  "mme:nextgcore-mmed"
  "sgwc:nextgcore-sgwcd"
  "sgwu:nextgcore-sgwud"
  "hss:nextgcore-hssd"
  "pcrf:nextgcore-pcrfd"
  "smf:nextgcore-smfd"
  "upf:nextgcore-upfd"
)

# nextgsim's own Dockerfiles; their context is the repo root (they COPY config/
# and scripts/ as well as binaries/, which is gitignored there):
#   cargo build --release -p nextgsim-enb --features kernel-sctp --bin lte-enb
#   cargo build --release -p nextgsim-lte-ue --bin lte-ue
#   cp target/release/lte-enb target/release/lte-ue binaries/
PROFILE_SIM_IMAGES=(
  "lte-enb:Dockerfile.enb-local:.:lte-enb"
  "lte-ue:Dockerfile.lte-ue-local:.:lte-ue"
)

# How to build the missing binaries (README "PROFILE=epc"); build-and-push.sh
# prints it. mmed is the kernel-sctp build, so it goes to its own
# CORE_BIN_DIR next to the six default-build binaries. The commands are POSIX
# sh and create the gitignored binaries/ dirs.
profile_build_hint() {
  local dir="${CORE_BIN_DIR}" b pkgs="" core="" mmed=false enb=false ue=false
  [[ "${dir}" == "${CORE_DIR}/binaries" ]] && dir="/tmp/epc-binaries"
  for b in ${MISSING_CORE_BINS[@]+"${MISSING_CORE_BINS[@]}"}; do
    if [[ "${b}" == nextgcore-mmed ]]; then
      mmed=true
    else
      pkgs+=" -p ${b}"
    fi
    core+=" target/release/${b}"
  done
  for b in ${MISSING_SIM_BINS[@]+"${MISSING_SIM_BINS[@]}"}; do
    case "${b}" in
      lte-enb) enb=true ;;
      lte-ue) ue=true ;;
    esac
  done
  if [[ -n "${core}" ]]; then
    printf '  cd %s/src' "${CORE_DIR}"
    [[ -n "${pkgs}" ]] && printf ' && cargo build --release%s' "${pkgs}"
    "${mmed}" && printf ' && \\\n    cargo build --release -p nextgcore-mmed --features kernel-sctp'
    printf ' && \\\n    mkdir -p %s && cp%s %s/\n' "${dir}" "${core}" "${dir}"
  fi
  if "${enb}" || "${ue}"; then
    printf '  cd %s' "${SIM_DIR}"
    "${enb}" && printf ' && cargo build --release -p nextgsim-enb --features kernel-sctp --bin lte-enb'
    "${ue}" && printf ' && \\\n    cargo build --release -p nextgsim-lte-ue --bin lte-ue'
    printf ' && \\\n    mkdir -p binaries && cp'
    "${enb}" && printf ' target/release/lte-enb'
    "${ue}" && printf ' target/release/lte-ue'
    printf ' binaries/\n'
  fi
  if [[ -n "${core}" && "${dir}" != "${CORE_BIN_DIR}" ]]; then
    printf 'then: PROFILE=epc CORE_BIN_DIR=%s %s\n' "${dir}" "$0"
  fi
}

# No SBI peers to advertise, no SUCI keys, no data-plane swap: the user plane
# is always on in this profile.
PROFILE_ADVERTISE_NFS=""
PROFILE_HNET_SECRET=false
PROFILE_DATAPLANE_DEPLOYMENT=""

# Transport of the mme Service's s1ap port: SCTP for kernel S1-MME.
S1AP_PROTOCOL="${S1AP_PROTOCOL:-SCTP}"

profile_postrender() {
  python3 - "$1" "${NAMESPACE}" "${S1AP_PROTOCOL}" <<'PY'
import sys, yaml
path, ns, s1ap = sys.argv[1:4]
src = open(path).read()
# The shared mongodb-init Job names MongoDB by its nextg-system FQDN; in this
# namespace that would wait forever, or seed the 5G profile's database.
src = src.replace('.nextg-system.svc.cluster.local', f'.{ns}.svc.cluster.local')
out, hit = [], False
for d in yaml.safe_load_all(src):
    if not d:
        continue
    if d.get('kind') == 'Service' and d['metadata']['name'] == 'mme':
        for p in d['spec']['ports']:
            if p['name'] == 's1ap':
                p['protocol'] = s1ap
                hit = True
    out.append(d)
if not hit:
    sys.exit('mme Service has no s1ap port')
if 'nextg-system' in yaml.safe_dump_all(out):
    sys.exit('a nextg-system reference survived in the epc render')
open(path, 'w').write(yaml.safe_dump_all(out, default_flow_style=False))
PY
}

profile_rollout() {
  log "waiting for MongoDB..."
  kubectl rollout status statefulset/mongodb -n "${NAMESPACE}" --timeout=300s \
    || warn "MongoDB not ready. Check: kubectl describe pvc -n ${NAMESPACE}"
  log "waiting for the MongoDB init job..."
  kubectl wait --for=condition=complete job/mongodb-init \
    -n "${NAMESPACE}" --timeout=180s || warn "init job did not complete"

  # Compose start order. A dependent that resolved a peer which then moved is
  # restarted by its epc-peers-check.sh liveness probe, so this orders the
  # bring-up rather than guarding it.
  local d
  for d in hss pcrf pgwu pgwc sgwu sgwc mme enb lte-ue; do
    log "waiting for ${d}..."
    kubectl rollout status "deployment/${d}" -n "${NAMESPACE}" --timeout=300s \
      || warn "${d} not ready - kubectl logs -n ${NAMESPACE} deploy/${d}"
  done
}

profile_summary() {
  cat <<EOS

Deployed (PROFILE=epc).

Verify:
  kubectl logs -n ${NAMESPACE} deploy/mme    | grep -E 'S1 Setup|EPS bearer'
  kubectl logs -n ${NAMESPACE} deploy/lte-ue | grep -E 'EMM-REGISTERED|default EPS bearer'
  PROFILE=epc ./e2e-internet.sh
EOS
}
