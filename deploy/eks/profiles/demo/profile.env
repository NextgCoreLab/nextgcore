# shellcheck shell=bash
# shellcheck disable=SC2034  # variables are read by the scripts that source this
# PROFILE=demo: sourced by build-and-push.sh, deploy-eks.sh and e2e-internet.sh
# (nextgcore#1395, nextgsim#458).
#
# The 6G profile (same NFs, images, rollout, config) in namespace nextg-demo,
# rendered from a demo overlay:
#
#   DEMO_OVERLAY unset (or "demo")  deploy/eks/overlays/demo: the demo-OFF control.
#                                   No demo: block anywhere; the 6G profile as is.
#   DEMO_OVERLAY=demo-<key>         deploy/eks/overlays/demo-<key>: the base plus
#                                   that demo's patches and its nextg-demo-toggles
#                                   ConfigMap. DEMO_KEY and DEMO_MODE are required.
#
# k8s/demo-check.sh <key> <mode> sets all three and drives deploy-eks.sh and
# e2e-internet.sh with PROFILE=demo.

DEMO_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../6g/profile.env
source "${DEMO_PROFILE_DIR}/../6g/profile.env"

PROFILE_NAMESPACE="nextg-demo"
PROFILE_NAMESPACE_MANIFEST="deploy/eks/overlays/demo/namespace.yaml"
PROFILE_POD_SECURITY="privileged"

DEMO_OVERLAY="${DEMO_OVERLAY:-demo}"
if [[ ! "${DEMO_OVERLAY}" =~ ^demo(-[a-z0-9][a-z0-9-]*)?$ ]]; then
  printf 'PROFILE=demo: DEMO_OVERLAY=%q is not demo or demo-<key>\n' "${DEMO_OVERLAY}" >&2
  return 1
fi
# A demo overlay that adds a core NF needs its image: built (with the demo's
# cargo feature) and pushed by build-and-push.sh, and rewritten to ECR by
# deploy-eks.sh, exactly like the profile's own NFs.
case "${DEMO_OVERLAY}" in
  demo-d441c-amf-mobility)
    # nextgsim#466: nwdafd with UE_MOBILITY from AMF LOCATION_REPORT events.
    PROFILE_CORE_NFS+=("nwdaf:nextgcore-nwdafd")
    PROFILE_CARGO_FEATURES+=" nextgcore-nwdafd/amf-mobility"
    ;;
  demo-d441a-congestion-loop)
    # nextgsim#465: nwdafd USER_DATA_CONGESTION from RAN cell reports, and the
    # pcfd Session-AMBR controller with its override layer.
    PROFILE_CORE_NFS+=("nwdaf:nextgcore-nwdafd")
    PROFILE_CARGO_FEATURES+=" nextgcore-nwdafd/demo-d441a-congestion-loop nextgcore-pcfd/demo-d441a-congestion-loop"
    ;;
  demo-d441e-model-retrain)
    # nextgsim#468: two nwdafd Deployments (nwdaf-mtlf, nwdaf-anlf) of one
    # nwdaf image with the MTLF/AnLF provisioning, monitoring and retrain.
    PROFILE_CORE_NFS+=("nwdaf:nextgcore-nwdafd")
    PROFILE_CARGO_FEATURES+=" nextgcore-nwdafd/demo-d441e-model-retrain"
    ;;
  demo-d445a-fl-t8)
    # nextgsim#480: nefd UE ID retrieval (TS 29.522) and the T8 delivery line.
    PROFILE_CORE_NFS+=("nef:nextgcore-nefd")
    PROFILE_CARGO_FEATURES+=" nextgcore-nefd/demo-d445a-fl-t8"
    ;;
esac
PROFILE_RENDER_DIR="$(cd "${DEMO_PROFILE_DIR}/../.." && pwd)/overlays/${DEMO_OVERLAY}"
if [[ ! -f "${PROFILE_RENDER_DIR}/kustomization.yaml" ]]; then
  printf 'PROFILE=demo: no overlay at %s\n' "${PROFILE_RENDER_DIR}" >&2
  return 1
fi

# The 6G profile's post-render (FQDNs to this namespace, NES and intent on)
# runs first; then the demo toggles, if the overlay has any.
eval "$(declare -f profile_postrender | sed '1s/^profile_postrender/sixg_profile_postrender/')"

profile_postrender() {
  sixg_profile_postrender "$1" || return 1
  python3 "${DEMO_PROFILE_DIR}/demo_toggles.py" "$1" \
    "${DEMO_OVERLAY}" "${DEMO_KEY:-}" "${DEMO_MODE:-}"
}

# Every Deployment the overlay adds needs a rollout wait, or verify_images'
# 90 s loop can start while one is still in its init container (the d445a
# gates arm: nef's wait-nrf stalled 2 m 20 s). Wait on the Deployments of the
# final render deploy-eks.sh applied (RENDERED), which is exactly the set
# verify_images checks. Not keyed on PROFILE_CORE_NFS: that names images, and
# one image can back several Deployments (d441e: nwdaf -> nwdaf-mtlf and
# nwdaf-anlf). A 5G NF waited on twice returns at once the second time.
eval "$(declare -f profile_rollout | sed '1s/^profile_rollout/fivg_profile_rollout/')"

# The Deployment names of a rendered multi-document manifest, one per line.
demo_render_deployments() {
  python3 -c '
import sys, yaml
for d in yaml.safe_load_all(open(sys.argv[1])):
    if isinstance(d, dict) and d.get("kind") == "Deployment":
        print(d["metadata"]["name"])
' "$1"
}

profile_rollout() {
  fivg_profile_rollout
  if [[ -z "${RENDERED:-}" || ! -s "${RENDERED}" ]]; then
    warn "no rendered manifest to read the demo Deployments from; only the 5G rollout waits ran"
    return 0
  fi
  local dep deps
  deps="$(demo_render_deployments "${RENDERED}")" \
    || { warn "could not list the Deployments of ${RENDERED}"; return 0; }
  log "waiting for every rendered Deployment: $(tr '\n' ' ' <<<"${deps}")"
  for dep in ${deps}; do
    kubectl rollout status "deployment/${dep}" -n "${NAMESPACE}" --timeout=300s \
      || warn "${dep} not ready - kubectl logs -n ${NAMESPACE} deploy/${dep}"
  done
}
