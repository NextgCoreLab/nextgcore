# The demo d443a-edge-budget UE image (nextgsim#471), built by build-images.sh.
# nextgsim's Dockerfile.ue-local (same pinned base) plus what the demo needs:
#   nr-ue        --features demo-d443a-edge-budget (the EEC client, she-offload)
#   nr-cli       she-offload job/status, demo d443a-edge-budget set/show
#   nr-she-eas   the EAS sidecar (nextgsim-she --features demo-d443a-edge-budget)
#   iproute2     ip netns (the dn DN), tc (netem for Acts 2 and 3)
#   iptables     dn's masquerade for the EASes' own calls
#   curl         probes
#   setpriv      (util-linux) nr-she-eas runs as nobody
# Demo image for devtest1 only, never published.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    iputils-ping \
    iproute2 \
    iptables \
    && rm -rf /var/lib/apt/lists/*

COPY nr-ue nr-cli nr-she-eas /usr/local/bin/

RUN mkdir -p /etc/nextgsim
WORKDIR /etc/nextgsim
ENV RUST_LOG=info
ENTRYPOINT ["nr-ue"]
CMD ["-c", "/etc/nextgsim/ue.yaml"]
